# Ignore everything; allow only project sources and configuration.
*
!/.gitignore
!/.editorconfig
!/.prettierrc
!/Makefile
!/AGENTS.md
!/README.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/vitest.config.mts
!/worker-configuration.d.ts
!/cloudflare.config.ts
!/wrangler.example.jsonc
!/.dev.vars.example
!/.env.example
!/.vscode/
!/.vscode/extensions.json
!/frontend/
!/frontend/*.tsx
!/frontend/*.css
!/frontend/*.html
!/frontend/public/
!/frontend/public/favicon.svg
!/src/
!/src/*.ts
!/migrations/
!/migrations/*.sql
!/test/
!/test/*.ts
!/test/*.json
