{
  "name": "leetcode-stats",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run build && cf d1 migrations apply \"$CF_D1_DATABASE_ID\" && cf deploy",
    "dev": "npm run build && cf dev --implArgs=--local",
    "start": "npm run dev",
    "test": "vitest",
    "cf-typegen": "cf workers types && node scripts/update_worker_types.mjs",
    "check": "tsc --noEmit && tsc --noEmit --jsx react-jsx --lib es2024,dom --target es2024 --moduleResolution bundler --module esnext --skipLibCheck frontend/App.tsx frontend/main.tsx && tsc --noEmit -p test/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "cf": "^1.0.0-beta.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.6.7"
  }
}
