{
  "name": "leetcode-stats",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "deploy": "npm run build && cf d1 migrations apply \"$CF_D1_DATABASE_ID\" && cf deploy",
    "dev": "npm run build && cf dev",
    "start": "npm run dev",
    "test": "vitest",
    "cf-typegen": "cf workers types",
    "check": "tsc --noEmit && tsc --noEmit --jsx react-jsx --lib es2024,dom --target es2024 --moduleResolution bundler --module esnext --skipLibCheck frontend/App.tsx frontend/main.tsx"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "cf": "^1.0.0-beta.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
